{
  "name": "soma-backend",
  "version": "1.0.0",
  "description": "SOMA API para monitoreo y reportes de autoclaves",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "npm run build && nodemon --watch dist --ext js,json dist/server.js",
    "watch": "nodemon --watch app --watch server.ts --watch database.ts --ext ts --exec npm run build"
  },
  "keywords": [
    "node.js",
    "express",
    "jwt",
    "authentication",
    "mongodb"
  ],
  "author": {
    "name": "Pablo Jesus Pedraza",
    "email": "pabloj.pedraza@gmail.com",
    "url": "https://github.com/wayaba"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "3.1.14",
    "typescript": "5.9.3"
  }
}
